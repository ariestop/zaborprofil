{
  "name": "zaborprofil-engine",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11.20.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && VITE_BUILD_TARGET=admin vite build",
    "build:site": "tsc --noEmit && VITE_BUILD_TARGET=site vite build",
    "typecheck": "tsc --noEmit",
    "test:frontend": "vitest run",
    "test:frontend:coverage": "vitest run --coverage",
    "test:e2e:smoke": "playwright test tests/e2e/admin-smoke.spec.ts",
    "test:e2e": "playwright test",
    "lint:admin": "eslint \"admin/{app,routes,layouts,pages,modules,features,entities,widgets,shared}/**/*.{ts,tsx}\"",
    "lint:site": "eslint \"assets/**/*.{ts,tsx}\"",
    "lint:frontend": "eslint \"{assets,admin}/**/*.{ts,tsx}\"",
    "check:chunks": "node tools/perf/check-admin-chunks.mjs",
    "format:check": "prettier --check \"assets/**/*.{ts,tsx,scss,css}\" \"admin/**/*.{ts,tsx,scss,css}\" \"docs/**/*.md\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.20",
    "@fontsource-variable/golos-text": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@fontsource/onest": "^5.3.1",
    "@fontsource/sofia-sans-condensed": "^5.3.0",
    "@hookform/resolvers": "^5.9.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^9.3.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-list": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-typography": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "dompurify": "^3.4.17",
    "lodash.throttle": "^4.1.1",
    "media-chrome": "^4.19.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-router-dom": "^7.18.4",
    "swiper": "^14.3.0",
