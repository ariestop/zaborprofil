{
  "name": "zaborprofil-engine",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:admin": "tsc --noEmit && VITE_BUILD_TARGET=admin vite build",
    "build:site": "tsc --noEmit && VITE_BUILD_TARGET=site vite build",
    "typecheck": "tsc --noEmit",
    "test:frontend": "vitest run",
    "test:e2e:smoke": "playwright test tests/e2e/admin-smoke.spec.ts",
    "lint:admin": "eslint \"assets/admin/{app,routes,layouts,pages,modules,features,entities,widgets,shared}/**/*.{ts,tsx}\"",
    "lint:frontend": "eslint \"assets/**/*.{ts,tsx}\"",
    "check:chunks": "node tools/perf/check-admin-chunks.mjs",
    "format:check": "prettier --check \"assets/**/*.{ts,tsx,scss,css}\" \"docs/**/*.md\""
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@floating-ui/react": "^0.27.19",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-highlight": "^3.22.5",
    "@tiptap/extension-horizontal-rule": "^3.22.5",
    "@tiptap/extension-image": "^3.22.5",
    "@tiptap/extension-link": "^3.22.5",
    "@tiptap/extension-list": "^3.22.5",
    "@tiptap/extension-subscript": "^3.22.5",
    "@tiptap/extension-superscript": "^3.22.5",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-typography": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/extensions": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "lodash.throttle": "^4.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.65.0",
    "react-hotkeys-hook": "^5.3.2",
    "react-router-dom": "^7.9.4",
    "recharts": "^3.3.0",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@base-ui/react": "^1.4.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/typography": "^0.5.0",
    "@testing-library/react": "^16.3.0",
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.0",
    "class-variance-authority": "^0.7.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "jsdom": "^27.0.1",
    "postcss": "^8.5.0",
    "prettier": "^3.6.2",
    "sass-embedded": "^1.99.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
