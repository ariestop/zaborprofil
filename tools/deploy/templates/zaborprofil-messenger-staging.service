[Unit]
Description=Zaborprofil Staging Symfony Messenger Worker
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/zaborprofil/current
Environment=APP_ENV=staging
ExecStart=/usr/bin/php bin/console messenger:consume async --time-limit=3600 --memory-limit=256M --env=staging --no-interaction
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
