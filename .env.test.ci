# GitHub Actions CI overrides for the `test` Symfony environment.
# This file is copied to `.env.test.local` by the CI workflow before running
# PHPUnit so the test suite runs against the real PostgreSQL service spun up
# in `.github/workflows/ci.yml` instead of the SQLite default.
DATABASE_URL="postgresql://zaborprofil_test:zaborprofil_test@127.0.0.1:5432/zaborprofil_test?serverVersion=18&charset=utf8"
REDIS_URL="redis://127.0.0.1:6379/1"
