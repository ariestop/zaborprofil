APP_ENV=staging
APP_DEBUG=0
APP_SECRET=change-this-staging-secret
APP_SHARE_DIR=/var/www/zaborprofil/shared

DATABASE_URL="mysql://zaborprofil_staging:change-me@127.0.0.1:3306/zaborprofil_staging?serverVersion=8.4&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://127.0.0.1:1025

LEAD_NOTIFICATION_EMAIL=
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=

# Error tracking (Sentry или self-hosted GlitchTip). Пусто — выключено. Персональные данные не отправляются.
SENTRY_DSN=
SENTRY_RELEASE=

SITE_URL="https://staging.zaborprofil.ru"
DEFAULT_URI="https://staging.zaborprofil.ru"

# Миграции из веб-админки отключены: миграции выполняются CLI при деплое.
ADMIN_WEB_MIGRATIONS_ENABLED=0
