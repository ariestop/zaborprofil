# Symfony Backend
SYMFONY_APP_ENV=dev
DATABASE_URL=mysql://app:app@127.0.0.1:3306/zaborprofil?serverVersion=8.0&charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documents

# Next.js Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_PAYLOAD_URL=http://localhost:3000

# Payload CMS (uses MongoDB or Postgres - see Payload docs)
PAYLOAD_SECRET=your-payload-secret-change-in-production
DATABASE_URI=mongodb://127.0.0.1:27017/payload

# AI Chat (Phase 1 - optional)
OPENAI_API_KEY=
