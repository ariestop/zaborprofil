<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ЗаборПрофиль{% endblock %}</title>
        {% block meta_description %}
            {% if meta_description is defined and meta_description %}
                <meta name="description" content="{{ meta_description }}">
            {% endif %}
        {% endblock %}
        {% block meta_robots %}
            <meta name="robots" content="{{ meta_robots is defined and meta_robots ? meta_robots : 'index, follow' }}">
        {% endblock %}
        {% block canonical_url %}
            {% if canonical_url is defined and canonical_url %}
                <link rel="canonical" href="{{ canonical_url }}">
            {% endif %}
        {% endblock %}
        {% block meta_open_graph %}
            <meta property="og:site_name" content="ЗаборПрофиль">
            <meta property="og:type" content="{{ og_type is defined and og_type ? og_type : 'website' }}">
            <meta property="og:title" content="{{ og_title is defined and og_title ? og_title : block('title') }}">
            {% if og_description is defined and og_description %}
                <meta property="og:description" content="{{ og_description }}">
            {% elseif meta_description is defined and meta_description %}
                <meta property="og:description" content="{{ meta_description }}">
            {% endif %}
            {% if canonical_url is defined and canonical_url %}
                <meta property="og:url" content="{{ canonical_url }}">
            {% endif %}
            {% if og_image is defined and og_image %}
                <meta property="og:image" content="{{ og_image }}">
                <meta name="twitter:card" content="summary_large_image">
                <meta name="twitter:image" content="{{ og_image }}">
            {% endif %}
        {% endblock %}
        {% block json_ld %}
            {% if json_ld_blocks is defined and json_ld_blocks %}
                {% for block in json_ld_blocks %}
                    <script type="application/ld+json">{{ block|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
                {% endfor %}
            {% endif %}
        {% endblock %}
        {% block stylesheets %}
            {{ vite_entry_link_tags('assets/site/app.ts') }}
        {% endblock %}
    </head>
    <body class="min-h-screen bg-slate-50 text-slate-950">
        {% block site_header %}
            {% set service_menu = menu_items('service') %}
            {% set header_menu = menu_items('header') %}

            {% if service_menu %}
                <nav class="border-b border-slate-200 bg-slate-900 text-sm text-white" aria-label="Сервисная навигация">
                    <div class="mx-auto flex max-w-6xl justify-end gap-5 px-6 py-2">
                        {% for item in service_menu %}
                            <a class="text-slate-200 hover:text-white" href="{{ item.url }}">{{ item.label }}</a>
                        {% endfor %}
                    </div>
                </nav>
            {% endif %}

            <header class="border-b border-slate-200 bg-white">
                <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
                    <a class="text-lg font-bold text-slate-950" href="/">ЗаборПрофиль</a>
                    {% if header_menu %}
                        <nav class="flex gap-5 text-sm font-medium text-slate-700" aria-label="Основная навигация">
                            {% for item in header_menu %}
                                <a class="hover:text-emerald-700" href="{{ item.url }}">{{ item.label }}</a>
                            {% endfor %}
                        </nav>
                    {% endif %}
                </div>
            </header>
        {% endblock %}

        {% block body %}{% endblock %}

        {% block site_footer %}
            {% set footer_menu = menu_items('footer') %}
            {% if footer_menu %}
                <footer class="border-t border-slate-200 bg-white">
                    <nav class="mx-auto flex max-w-6xl flex-wrap gap-5 px-6 py-6 text-sm text-slate-600" aria-label="Навигация в подвале">
                        {% for item in footer_menu %}
                            <a class="hover:text-emerald-700" href="{{ item.url }}">{{ item.label }}</a>
                        {% endfor %}
                    </nav>
                </footer>
            {% endif %}
        {% endblock %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
