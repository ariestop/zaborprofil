<!doctype html>
<html lang="ru">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}ЗаборПрофиль{% endblock %}</title>
        {% block meta_description %}
            {% if meta_description is defined and meta_description %}
                <meta name="description" content="{{ meta_description }}">
            {% endif %}
        {% endblock %}
        {% block meta_robots %}
            <meta name="robots" content="{{ meta_robots is defined and meta_robots ? meta_robots : 'index, follow' }}">
        {% endblock %}
        {% block canonical_url %}
            {% if canonical_url is defined and canonical_url %}
                <link rel="canonical" href="{{ canonical_url }}">
            {% endif %}
        {% endblock %}
        {% block meta_open_graph %}
            <meta property="og:site_name" content="ЗаборПрофиль">
            <meta property="og:type" content="{{ og_type is defined and og_type ? og_type : 'website' }}">
            <meta property="og:title" content="{{ og_title is defined and og_title ? og_title : block('title') }}">
            {% if og_description is defined and og_description %}
                <meta property="og:description" content="{{ og_description }}">
            {% elseif meta_description is defined and meta_description %}
                <meta property="og:description" content="{{ meta_description }}">
            {% endif %}
            {% if canonical_url is defined and canonical_url %}
                <meta property="og:url" content="{{ canonical_url }}">
            {% endif %}
            {% if og_image is defined and og_image %}
                <meta property="og:image" content="{{ og_image }}">
                <meta name="twitter:card" content="summary_large_image">
                <meta name="twitter:image" content="{{ og_image }}">
            {% endif %}
        {% endblock %}
        {% block json_ld %}
            {% if json_ld_blocks is defined and json_ld_blocks %}
                {% for block in json_ld_blocks %}
                    <script type="application/ld+json">{{ block|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
                {% endfor %}
            {% endif %}
        {% endblock %}
        <link rel="icon" href="/favicon.svg" type="image/svg+xml">
        <meta name="theme-color" content="#ffffff">
        {% block stylesheets %}
            {{ vite_entry_link_tags('assets/site/app.ts') }}
        {% endblock %}
    </head>
    {# Контакты для шапки и нижней панели задаются в админке: настройки contacts.phone, contacts.messenger_url, contacts.calculator_url. #}
    {% set contact_phone = setting('contacts', 'phone', '') %}
    {% set contact_messenger_url = setting('contacts', 'messenger_url', '') %}
    {% set contact_calculator_url = setting('contacts', 'calculator_url', '') %}
    {% set contact_phone_href = contact_phone ? 'tel:' ~ contact_phone|replace({' ': '', '(': '', ')': '', '-': '', '‑': ''}) : '' %}
    <body class="{% block body_class %}min-h-screen bg-white text-base text-ink antialiased{% if contact_phone or contact_messenger_url or contact_calculator_url %} pb-24 md:pb-0{% endif %}{% endblock %}">
        {% block site_header %}
            {% set service_menu = menu_items('service') %}
            {% set header_menu = menu_items('header') %}

            {% if service_menu %}
                <nav class="border-b border-slate-200 bg-slate-900 text-sm text-white" aria-label="Сервисная навигация">
                    <div class="mx-auto flex max-w-6xl justify-end gap-5 px-6 py-2">
                        {% for item in service_menu %}
                            <a class="text-slate-200 hover:text-white" href="{{ item.url }}">{{ item.label }}</a>
                        {% endfor %}
                    </div>
                </nav>
            {% endif %}

            <header class="border-b border-line bg-white">
                <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-4 py-3 sm:px-6">
                    <a class="block w-40 sm:hidden [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" href="/" aria-label="Забор Профиль — на главную">{{ source('brand/logo-compact.svg') }}</a>
                    <a class="hidden w-60 sm:block [&>svg]:block [&>svg]:h-auto [&>svg]:w-full" href="/" aria-label="Забор Профиль — на главную">{{ source('brand/logo-horizontal.svg') }}</a>
                    {% if header_menu %}
                        <nav class="order-last -mx-4 flex w-[calc(100%+2rem)] gap-5 overflow-x-auto px-4 pb-1 text-[0.9375rem] font-medium whitespace-nowrap text-ink md:order-none md:mx-0 md:w-auto md:overflow-visible md:px-0 md:pb-0" aria-label="Основная навигация">
                            {% for item in header_menu %}
                                <a class="py-2 hover:text-brand-700" href="{{ item.url }}">{{ item.label }}</a>
                            {% endfor %}
                        </nav>
                    {% endif %}
                    {% if contact_phone %}
                        <a class="price hidden text-2xl text-ink hover:text-brand-700 sm:block" href="{{ contact_phone_href }}">{{ contact_phone }}</a>
                    {% endif %}
                </div>
            </header>
        {% endblock %}

        {% block body %}{% endblock %}

        {% block site_footer %}
            {% set footer_menu = menu_items('footer') %}
            {% if footer_menu %}
                <footer class="border-t border-line bg-white">
                    <nav class="mx-auto flex max-w-6xl flex-wrap gap-5 px-4 py-6 text-[0.9375rem] text-graphite sm:px-6" aria-label="Навигация в подвале">
                        {% for item in footer_menu %}
                            <a class="hover:text-brand-700" href="{{ item.url }}">{{ item.label }}</a>
                        {% endfor %}
                    </nav>
                </footer>
            {% endif %}

            {% if contact_phone or contact_messenger_url or contact_calculator_url %}
                <nav class="mobile-bar md:hidden" aria-label="Быстрая связь">
                    {% if contact_phone %}
                        <a href="{{ contact_phone_href }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg>
                            Позвонить
                        </a>
                    {% endif %}
                    {% if contact_messenger_url %}
                        <a href="{{ contact_messenger_url }}" rel="noopener">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.6 8.6 0 0 1-3.8-.9L3 21l1.9-5.2a8.4 8.4 0 0 1-.9-3.8A8.5 8.5 0 0 1 12.5 3 8.4 8.4 0 0 1 21 11.5z"/></svg>
                            Написать
                        </a>
                    {% endif %}
                    {% if contact_calculator_url %}
                        <a class="is-primary" href="{{ contact_calculator_url }}">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="4" y="2" width="16" height="20" rx="2"/><path d="M8 6h8M8 11h2M14 11h2M8 15h2M14 15h2M8 19h8"/></svg>
                            Рассчитать
                        </a>
                    {% endif %}
                </nav>
            {% endif %}
        {% endblock %}
        {% block javascripts %}{% endblock %}
    </body>
</html>
