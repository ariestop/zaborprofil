{% extends 'base.html.twig' %}

{% block title %}Админ-панель{% endblock %}

{% block meta_robots %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block site_header %}{% endblock %}
{% block site_footer %}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <meta name="admin-csrf-token" content="{{ csrf_token('admin_api') }}">
    <meta name="admin-csrf-header" content="X-CSRF-Token">
{% endblock %}

{% block body %}
    <main class="min-h-screen bg-slate-100">
        <div
            id="admin-app"
            data-user-email="{{ app.user ? app.user.userIdentifier : '' }}"
            data-logout-url="{{ path('admin_logout') }}"
            data-logout-token="{{ csrf_token('logout') }}"
        ></div>
    </main>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    {{ vite_entry_script_tags('assets/admin/app.ts') }}
{% endblock %}
