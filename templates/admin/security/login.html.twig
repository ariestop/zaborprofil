{% extends 'base.html.twig' %}

{% block title %}Вход в админ-панель{% endblock %}

{% block meta_robots %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block site_header %}{% endblock %}
{% block site_footer %}{% endblock %}

{% block body %}
    <main class="flex min-h-screen items-center justify-center px-6 py-12">
        <form method="post" action="{{ path('admin_login') }}" class="w-full max-w-md rounded-2xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
            <h1 class="text-2xl font-bold text-slate-950">Вход в админ-панель</h1>
            <p class="mt-2 text-sm text-slate-600">Введите email и пароль администратора.</p>

            {% if error %}
                <div class="mt-6 rounded-lg bg-red-50 px-4 py-3 text-sm text-red-700">
                    {{ error.messageKey|trans(error.messageData, 'security') }}
                </div>
            {% endif %}

            <label class="mt-6 block text-sm font-medium text-slate-700" for="username">Email</label>
            <input id="username" name="_username" type="email" value="{{ last_username }}" autocomplete="username" required autofocus class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2">

            <label class="mt-4 block text-sm font-medium text-slate-700" for="password">Пароль</label>
            <input id="password" name="_password" type="password" autocomplete="current-password" required class="mt-2 w-full rounded-lg border border-slate-300 px-3 py-2">

            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

            <button type="submit" class="mt-6 w-full rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white hover:bg-emerald-800">
                Войти
            </button>
        </form>
    </main>
{% endblock %}
