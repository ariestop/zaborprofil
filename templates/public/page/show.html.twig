{% extends 'base.html.twig' %}

{% block title %}{{ seo_title is defined and seo_title ? seo_title : page.title }}{% endblock %}

{% block body %}
    {% set page_breadcrumbs = breadcrumbs is defined ? breadcrumbs : breadcrumbs_for_page(page) %}
    {% set h1_in_block = heading_in_first_block is defined and heading_in_first_block %}

    <main>
        {# Хлебные крошки показываем на внутренних страницах; на главной (одна «крошка») они не нужны. #}
        {% if page_breadcrumbs|length > 1 %}
            <nav class="border-b border-line bg-surface" aria-label="Хлебные крошки">
                <ol class="zp-container flex items-center gap-1.5 overflow-x-auto py-2.5 text-sm whitespace-nowrap text-graphite">
                    {% for breadcrumb in page_breadcrumbs %}
                        <li class="flex items-center gap-1.5">
                            {% if breadcrumb.current %}
                                <span class="font-medium text-ink" aria-current="page">{{ breadcrumb.label }}</span>
                            {% else %}
                                <a class="hover:text-brand-700" href="{{ breadcrumb.path }}">{{ breadcrumb.label }}</a>
                                <span class="text-line-strong" aria-hidden="true">/</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </nav>
        {% endif %}

        {# Если страница начинается с первого экрана, H1 выводится внутри него. #}
        {% if not h1_in_block %}
            <div class="zp-container pt-8 md:pt-12">
                <h1 class="text-3xl font-bold tracking-tight text-balance text-ink md:text-4xl">{{ page.h1 }}</h1>
            </div>
        {% endif %}

        {% for block in blocks %}
            {{ block|raw }}
        {% endfor %}

        {# Если форма заявки уже стоит среди блоков, вторая внизу страницы не нужна. #}
        {% set has_inline_lead_form = false %}
        {% for block in blocks %}
            {% if 'id="lead-form"' in (block ~ '') %}{% set has_inline_lead_form = true %}{% endif %}
        {% endfor %}
        {% if not has_inline_lead_form %}
            <section class="zp-section zp-section--alt">
                <div class="zp-container max-w-3xl">
                    {% include 'public/partials/lead_form.html.twig' %}
                </div>
            </section>
        {% endif %}
    </main>
{% endblock %}
