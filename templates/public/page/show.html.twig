{% extends 'base.html.twig' %}

{% block title %}{{ page.title }}{% endblock %}

{% block body %}
    <main class="mx-auto max-w-6xl px-6 py-12">
        {% set page_breadcrumbs = breadcrumbs is defined ? breadcrumbs : breadcrumbs_for_page(page) %}
        {% if page_breadcrumbs|length > 1 %}
            <nav class="mb-8 text-sm text-slate-500" aria-label="Хлебные крошки">
                <ol class="flex flex-wrap gap-2">
                    {% for breadcrumb in page_breadcrumbs %}
                        <li>
                            {% if breadcrumb.current %}
                                <span class="text-slate-700" aria-current="page">{{ breadcrumb.label }}</span>
                            {% else %}
                                <a class="hover:text-emerald-700" href="{{ breadcrumb.path }}">{{ breadcrumb.label }}</a>
                                <span class="ml-2 text-slate-300">/</span>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </nav>
        {% endif %}

        <h1 class="text-4xl font-bold tracking-tight text-slate-950">{{ page.h1 }}</h1>

        <div class="mt-10 space-y-10">
            {% for block in blocks %}
                {{ block|raw }}
            {% endfor %}
        </div>

        <div class="mt-12">
            {% include 'public/partials/lead_form.html.twig' %}
        </div>
    </main>
{% endblock %}
