<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" id="lead-form">
    <h2 class="text-2xl font-bold tracking-tight text-slate-950">Получить консультацию</h2>
    <p class="mt-2 text-sm text-slate-600">Оставьте контакты, и менеджер свяжется с вами для расчёта.</p>

    <form class="js-lead-form mt-5 grid gap-4" action="/api/leads" method="post" data-page-url="{{ app.request.uri }}">
        <input type="hidden" name="source" value="public_page_form">
        <input type="hidden" name="formLoadedAt" value="{{ 'now'|date(constant('DATE_ATOM')) }}">
        <input type="hidden" name="pageUrl" value="{{ app.request.uri }}">
        <input type="hidden" name="policyUrl" value="/privacy/">

        <label class="hidden" aria-hidden="true">
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off">
        </label>

        <label class="grid gap-1 text-sm font-medium text-slate-700">
            Имя
            <input class="rounded-lg border border-slate-300 px-3 py-2" name="name" autocomplete="name" required>
        </label>

        <label class="grid gap-1 text-sm font-medium text-slate-700">
            Телефон
            <input class="rounded-lg border border-slate-300 px-3 py-2" name="phone" autocomplete="tel" required>
        </label>

        <label class="grid gap-1 text-sm font-medium text-slate-700">
            Email
            <input class="rounded-lg border border-slate-300 px-3 py-2" name="email" type="email" autocomplete="email">
        </label>

        <label class="grid gap-1 text-sm font-medium text-slate-700">
            Сообщение
            <textarea class="rounded-lg border border-slate-300 px-3 py-2" name="message" rows="4"></textarea>
        </label>

        <label class="flex gap-2 text-sm text-slate-600">
            <input class="mt-1 rounded border-slate-300" type="checkbox" name="consent" required>
            <span>Согласен на обработку персональных данных.</span>
        </label>

        <input type="hidden" name="consentText" value="Пользователь согласился на обработку персональных данных.">

        <button class="rounded-lg bg-emerald-700 px-4 py-2.5 font-semibold text-white hover:bg-emerald-800" type="submit">
            Отправить заявку
        </button>
        <p class="js-lead-form-status text-sm text-slate-600" role="status"></p>
    </form>
</section>
