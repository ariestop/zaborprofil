<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs" id="lead-form">
    <h2 class="text-2xl font-bold tracking-tight text-ink">Получить консультацию</h2>
    <p class="mt-2 text-graphite">Оставьте контакты, и менеджер свяжется с вами для расчёта.</p>

    <form class="js-lead-form mt-5 grid gap-4" action="/api/leads" method="post" data-page-url="{{ app.request.uri }}">
        <input type="hidden" name="source" value="public_page_form">
        <input type="hidden" name="formLoadedAt" value="{{ 'now'|date(constant('DATE_ATOM')) }}">
        <input type="hidden" name="pageUrl" value="{{ app.request.uri }}">
        <input type="hidden" name="policyUrl" value="/privacy/">

        <label class="hidden" aria-hidden="true">
            Website
            <input type="text" name="website" tabindex="-1" autocomplete="off">
        </label>

        <label class="field">
            <span class="field-label">Имя</span>
            <input class="field-input" name="name" autocomplete="name" required>
        </label>

        <label class="field">
            <span class="field-label">Телефон</span>
            <input class="field-input" name="phone" type="tel" autocomplete="tel" required>
        </label>

        <label class="field">
            <span class="field-label">Email</span>
            <input class="field-input" name="email" type="email" autocomplete="email">
        </label>

        <label class="field">
            <span class="field-label">Сообщение</span>
            <textarea class="field-input" name="message" rows="4"></textarea>
        </label>

        <label class="flex gap-3 text-[0.9375rem] text-graphite">
            <input class="mt-1 size-5 shrink-0 rounded-sm border-line-strong accent-brand-700" type="checkbox" name="consent" required>
            <span>Согласен на обработку персональных данных.</span>
        </label>

        <input type="hidden" name="consentText" value="Пользователь согласился на обработку персональных данных.">

        <button class="btn btn-primary w-full sm:w-auto sm:justify-self-start" type="submit">
            Перезвоните мне
        </button>
        <p class="js-lead-form-status text-graphite" role="status"></p>
    </form>
</section>
