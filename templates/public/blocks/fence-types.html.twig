{#
  Карточки видов продукта/покрытий: фото, название и описание. В тексте строки «– …» или «• …» становятся маркированным списком,
  первая строка без маркера — короткий подзаголовок карточки.
#}
{% set items = (block.content.items ?? [])|filter(item => (item.title ?? '') is not empty) %}
{% if items|length > 0 %}
    <section class="zp-section zp-section--alt" data-block-type="fence-types" {% if (block.settings.anchor ?? '') is not empty %}id="{{ block.settings.anchor }}"{% endif %}>
        <div class="zp-container">
            {% if (block.content.title ?? '') is not empty %}
                <h2 class="zp-h2 mb-6 md:mb-8">{{ block.content.title }}</h2>
            {% endif %}
            {# На телефоне карточки листаются свайпом, на планшете и ПК — три колонки. #}
            <div class="-mx-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-pl-4 px-4 pb-3 md:mx-0 md:grid md:snap-none md:grid-cols-3 md:gap-5 md:overflow-visible md:px-0 md:pb-0">
                {% for item in items %}
                    {% set lines = (item.text ?? '')|split("\n")|map(line => line|trim)|filter(line => line is not empty) %}
                    <article class="flex w-[86%] max-w-sm shrink-0 snap-start flex-col overflow-hidden rounded-3xl bg-white ring-1 ring-line md:w-auto md:max-w-none">
                        {% if (item.image ?? '') is not empty %}
                            {{ responsive_image(item.image, {
                                alt: item.alt ?? null,
                                fallback_alt: item.title,
                                class: 'aspect-4/3 w-full object-cover',
                                sizes: '(min-width: 1152px) 370px, (min-width: 768px) 33vw, 100vw'
                            }) }}
                        {% endif %}
                        <div class="flex flex-1 flex-col p-5 sm:p-6">
                            <h3 class="text-xl font-bold tracking-tight text-ink">{{ item.title }}</h3>
                            {% set bullets = [] %}
                            {% for line in lines %}
                                {% if line starts with '–' or line starts with '•' or line starts with '-' %}
                                    {% set bullets = bullets|merge([line|trim('–•- ')]) %}
                                {% elseif loop.first %}
                                    <p class="mt-1 text-sm font-semibold text-brand-700">{{ line }}</p>
                                {% else %}
                                    <p class="mt-3 text-base leading-7 text-graphite">{{ line }}</p>
                                {% endif %}
                            {% endfor %}
                            {% if bullets|length > 0 %}
                                <ul class="zp-checklist mt-4 text-sm text-ink">
                                    {% for bullet in bullets %}
                                        <li><svg aria-hidden="true"><use href="#i-check"/></svg><span>{{ bullet }}</span></li>
                                    {% endfor %}
                                </ul>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
