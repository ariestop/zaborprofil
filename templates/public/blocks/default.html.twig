<section class="zp-section" data-block-type="{{ block.type }}">
    <div class="zp-container">
        <h2 class="zp-h2">{{ block.name }}</h2>
        {% if (block.content.text ?? '') is not empty %}
            <div class="prose prose-slate mt-4 max-w-3xl">
                {{ block.content.text|nl2br }}
            </div>
        {% endif %}
    </div>
</section>
