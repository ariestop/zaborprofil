<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-block-type="price_cards">
    <h2 class="text-2xl font-semibold text-slate-950">{{ block.content.title|default(block.name) }}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
        {% for item in block.content.items|default([]) %}
            <article class="rounded-xl border border-slate-200 p-5">
                <h3 class="font-semibold text-slate-950">{{ item.title|default('Позиция') }}</h3>
                <p class="mt-3 text-2xl font-bold text-emerald-700">{{ item.price|default('по запросу') }}</p>
                {% if item.text is defined %}
                    <p class="mt-2 text-sm text-slate-600">{{ item.text }}</p>
                {% endif %}
            </article>
        {% else %}
            <p class="text-sm text-slate-500">Цены будут добавлены редактором.</p>
        {% endfor %}
    </div>
</section>
