{% set items = block.content.items ?? [] %}
{% if items is iterable and items|length > 0 %}
    <section class="rounded-2xl bg-slate-50 p-6" data-block-type="features">
        {% if (block.content.title ?? '') is not empty %}
            <h2 class="mb-6 text-2xl font-semibold text-slate-950">{{ block.content.title }}</h2>
        {% endif %}
        <div class="grid gap-4 md:grid-cols-3">
            {% for item in items %}
                <article class="rounded-xl bg-white p-5 shadow-xs">
                    <h3 class="font-semibold text-slate-950">{{ item.title ?? '' }}</h3>
                    {% if (item.text ?? '') is not empty %}
                        <p class="mt-2 text-sm leading-6 text-slate-600">{{ item.text }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </section>
{% endif %}
