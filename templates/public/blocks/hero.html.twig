<section class="relative isolate overflow-hidden rounded-3xl bg-emerald-900 px-8 py-14 text-white" data-block-type="hero">
    {% if block.content.image is defined and block.content.image %}
        {{ responsive_image(block.content.image, {
            decorative: true,
            class: 'absolute inset-0 -z-10 h-full w-full object-cover',
            sizes: '(min-width: 1152px) 1152px, 100vw',
            priority: above_fold|default(false)
        }) }}
        <div class="absolute inset-0 -z-10 bg-emerald-950/60"></div>
    {% endif %}
    <p class="text-sm font-semibold uppercase tracking-wide text-emerald-100">{{ block.name }}</p>
    <h2 class="mt-3 text-4xl font-bold">{{ block.content.title|default(block.name) }}</h2>
    {% if block.content.text is defined %}
        <p class="mt-5 max-w-3xl text-lg leading-8 text-emerald-50">{{ block.content.text }}</p>
    {% endif %}
</section>
