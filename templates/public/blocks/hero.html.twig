<section class="rounded-[var(--radius-card)] bg-night px-8 py-14 text-white" data-block-type="hero">
    <p class="eyebrow text-brand-300">{{ block.name }}</p>
    <h2 class="mt-3 text-4xl font-extrabold tracking-tight text-balance">{{ block.content.title|default(block.name) }}</h2>
    {% if block.content.text is defined %}
        <p class="mt-5 max-w-3xl text-lg leading-8 text-white/85">{{ block.content.text }}</p>
    {% endif %}
</section>
