{#
  Прайс-лист с выбором. Данные: groups[] — вкладки («С покрытием», «Оцинкованный»); в группе rows[] — профили,
  options[] — варианты с ценами по профилям. Сервер сразу отдаёт цены первого профиля, а полная таблица (все цены)
  лежит в <details>, поэтому прайс виден поисковикам и работает без JS.
#}
{% set groups = (block.content.groups ?? [])|filter(group => (group.rows ?? [])|length > 0 and (group.options ?? [])|length > 0) %}
{% set unit = block.content.unit ?? '₽/м²' %}
{% set tones = {
    peach: 'bg-orange-100 text-orange-900',
    amber: 'bg-amber-100 text-amber-900',
    blue: 'bg-blue-100 text-blue-900',
    orange: 'bg-orange-200 text-orange-950',
    green: 'bg-brand-100 text-brand-900'
} %}
{% macro money(value) %}{{ value is null ? '—' : value|number_format(0, '', ' ') }}{% endmacro %}
{% if groups|length > 0 %}
    <section class="zp-section" data-block-type="price-matrix" data-price-matrix {% if (block.settings.anchor ?? '') is not empty %}id="{{ block.settings.anchor }}"{% endif %}>
        <div class="zp-container">
            {% if (block.content.title ?? '') is not empty %}
                <h2 class="zp-h2">{{ block.content.title }}</h2>
            {% endif %}
            {% if (block.content.subtitle ?? '') is not empty %}
                <p class="zp-lead">{{ block.content.subtitle }}</p>
            {% endif %}

            {% if groups|length > 1 %}
                <div class="zp-seg mt-6" role="tablist" aria-label="Вид материала">
                    {% for group in groups %}
                        <button type="button" role="tab" class="zp-seg__item" id="pm-{{ block.id }}-tab-{{ loop.index0 }}" aria-controls="pm-{{ block.id }}-panel-{{ loop.index0 }}" aria-selected="{{ loop.first ? 'true' : 'false' }}" data-pm-tab="{{ loop.index0 }}">{{ group.label }}</button>
                    {% endfor %}
                </div>
            {% endif %}

            {% for group in groups %}
                {% set gi = loop.index0 %}
                {% set rows = group.rows %}
                {% set first_row = rows|first %}
                {% set options = group.options %}
                {% set specs_labels = [] %}
                {% for option in options %}
                    {% for spec in option.specs ?? [] %}
                        {% if spec.label not in specs_labels %}{% set specs_labels = specs_labels|merge([spec.label]) %}{% endif %}
                    {% endfor %}
                {% endfor %}
                {% set group_names = [] %}
                {% for option in options %}
                    {% if (option.group ?? '') is not empty and option.group not in group_names %}{% set group_names = group_names|merge([option.group]) %}{% endif %}
                {% endfor %}
                <div class="mt-6" role="tabpanel" id="pm-{{ block.id }}-panel-{{ gi }}" {% if groups|length > 1 %}aria-labelledby="pm-{{ block.id }}-tab-{{ gi }}"{% endif %} data-pm-panel="{{ gi }}">
                    {% if (group.note ?? '') is not empty %}
                        <p class="mb-4 max-w-3xl text-base leading-7 text-graphite">{{ group.note }}</p>
                    {% endif %}

                    <fieldset class="min-w-0">
                        <legend class="mb-2 text-sm font-semibold text-graphite">{{ group.rowsLabel ?? 'Профиль' }}</legend>
                        <div class="zp-pills">
                            {% for row in rows %}
                                <label class="zp-pill">
                                    <input class="peer sr-only" type="radio" name="pm-{{ block.id }}-row-{{ gi }}" value="{{ row }}" data-pm-row {{ loop.first ? 'checked' : '' }}>
                                    <span>{{ row }}</span>
                                </label>
                            {% endfor %}
                        </div>
                    </fieldset>

                    {% if (group.filterLabel ?? '') is not empty and group_names|length > 1 %}
                        <fieldset class="mt-4 min-w-0">
                            <legend class="mb-2 text-sm font-semibold text-graphite">{{ group.filterLabel }}</legend>
                            <div class="zp-pills">
                                <label class="zp-pill">
                                    <input class="peer sr-only" type="radio" name="pm-{{ block.id }}-filter-{{ gi }}" value="" data-pm-filter checked>
                                    <span>Все</span>
                                </label>
                                {% for name in group_names %}
                                    <label class="zp-pill">
                                        <input class="peer sr-only" type="radio" name="pm-{{ block.id }}-filter-{{ gi }}" value="{{ name }}" data-pm-filter>
                                        <span>{{ name }}</span>
                                    </label>
                                {% endfor %}
                            </div>
                        </fieldset>
                    {% endif %}

                    <p class="mt-5 text-sm text-graphite" role="status" aria-live="polite" data-pm-count></p>

                    <ul class="{{ (group.compact ?? false) ? 'grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6' : 'grid gap-3 sm:grid-cols-2 lg:grid-cols-3' }} mt-3" data-pm-list {% if not (group.compact ?? false) %}data-pm-limit="{{ group.limit ?? 6 }}"{% endif %}>
                        {% for option in options %}
                            {% set price = (option.prices ?? {})[first_row] ?? null %}
                            {% set tone = tones[option.tone ?? ''] ?? 'bg-line text-ink' %}
                            <li class="zp-option {{ (group.compact ?? false) ? 'zp-option--compact' : '' }}" data-pm-option data-group="{{ option.group ?? '' }}" data-prices="{{ (option.prices ?? {})|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}" {% if price is null %}hidden{% endif %}>
                                {% if group.compact ?? false %}
                                    <p class="text-sm font-semibold text-graphite">{{ option.title }}</p>
                                    <p class="zp-price mt-1 text-2xl text-ink"><span data-pm-price>{{ _self.money(price) }}</span> <span class="text-sm font-semibold text-graphite">{{ unit }}</span></p>
                                {% else %}
                                    <div class="flex items-start justify-between gap-3">
                                        <h3 class="text-lg leading-snug font-bold text-ink">{{ option.title }}</h3>
                                        {% if (option.group ?? '') is not empty %}
                                            <span class="shrink-0 rounded-full px-2.5 py-1 text-xs font-bold {{ tone }}">{{ option.group }}</span>
                                        {% endif %}
                                    </div>
                                    {% if (option.specs ?? [])|length > 0 %}
                                        <ul class="mt-3 flex flex-wrap gap-1.5 text-sm">
                                            {% for spec in option.specs %}
                                                {% set chip = spec.chip ?? '' %}
                                                {% if chip != '-' and spec.value is not empty %}
                                                    <li class="rounded-lg bg-white px-2.5 py-1 font-semibold text-ink">{{ chip is not empty ? chip : spec.label ~ ': ' ~ spec.value }}</li>
                                                {% endif %}
                                            {% endfor %}
                                        </ul>
                                    {% endif %}
                                    <div class="mt-4 flex items-end justify-between gap-3 border-t border-line pt-4">
                                        <p class="zp-price text-3xl text-brand-800"><span data-pm-price>{{ _self.money(price) }}</span> <span class="text-sm font-semibold text-graphite">{{ unit }}</span></p>
                                        <a class="zp-btn zp-btn--tonal zp-btn--sm" href="#lead-form" data-lead-plan="{{ option.title }}, {{ first_row }}" data-pm-order data-title="{{ option.title }}" data-details="{{ (option.specs ?? [])|filter(spec => (spec.chip ?? '') != '-' and (spec.value ?? '') is not empty)|map(spec => spec.value)|join(', ') }}">Заказать</a>
                                    </div>
                                {% endif %}
                            </li>
                        {% endfor %}
                    </ul>
                    <div class="mt-4 text-center" data-pm-more-wrap hidden>
                        <button type="button" class="zp-btn zp-btn--ghost" data-pm-more></button>
                    </div>
                    <p class="mt-4 rounded-2xl bg-surface p-5 text-base text-graphite" data-pm-empty hidden>Для этого профиля нет вариантов в выбранном классе. Выберите другой профиль или класс — или позвоните, подберём аналог.</p>

                    <details class="zp-fulltable mt-6">
                        <summary>Показать полную таблицу цен ({{ unit }})</summary>
                        <div class="zp-scroll mt-3">
                            <table class="zp-ptable-full">
                                <thead>
                                    <tr>
                                        <th scope="col">Вариант</th>
                                        {% for label in specs_labels %}<th scope="col">{{ label }}</th>{% endfor %}
                                        {% for row in rows %}<th scope="col" class="text-right">{{ row }}</th>{% endfor %}
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for option in options %}
                                        <tr>
                                            <th scope="row">{{ option.title }}{% if (option.group ?? '') is not empty %} <span class="text-graphite">· {{ option.group }}</span>{% endif %}</th>
                                            {% for label in specs_labels %}
                                                {% set found = '' %}
                                                {% for spec in option.specs ?? [] %}{% if spec.label == label %}{% set found = spec.value %}{% endif %}{% endfor %}
                                                <td>{{ found }}</td>
                                            {% endfor %}
                                            {% for row in rows %}
                                                <td class="text-right font-cond text-base font-semibold tabular-nums">{{ _self.money((option.prices ?? {})[row] ?? null) }}</td>
                                            {% endfor %}
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </details>
                </div>
            {% endfor %}
        </div>
    </section>
{% endif %}
