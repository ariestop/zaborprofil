{#
    Сцена конфигуратора забора: вид с тротуара, глаза на высоте 1,6 м.
    Забор — в плоскости 103,4 px/м (низ — y 414), дерево на участке — 0,7 этого масштаба, дом в глубине — 0,42.
    Поэтому высокий забор закрывает окна дома, как в жизни. Человек 1,75 м и линейка дают масштаб.
    Цвет — --ral, рисунок — pattern, покрытие — finish (gloss | matte | wood); assets/site/configurator.ts меняет
    у [data-fence-body] атрибуты y/height и у [data-fence-top] — сдвиг (те же константы GROUND и SCALE).
    Цвета неба, дома и земли — это иллюстрация, а не интерфейс (исключение из запрета HEX, docs/50-brand-system.md).
    Параметры: uid, pattern, finish, ral (HEX), height (м), label.
#}
{% set ground = 414 %}
{% set scale = 103.4 %}
{% set top = ground - height * scale %}
{% set posts = [124, 383, 641, 900, 1158] %}
{% set height_label = height|number_format(1, ',', '') ~ ' м' %}
<svg class="zp-scene" viewBox="0 0 1200 470" preserveAspectRatio="xMinYMax slice" data-cfg-scene data-pattern="{{ pattern }}" data-finish="{{ finish }}" style="--ral: {{ ral }}" role="img" aria-label="{{ label }}">
    <defs>
        <linearGradient id="{{ uid }}-sky" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#93c1e2"/><stop offset="1" stop-color="#e6f0f6"/></linearGradient>
        <linearGradient id="{{ uid }}-glass" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".55"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/></linearGradient>
        <linearGradient id="{{ uid }}-walk" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#b3afa6"/><stop offset="1" stop-color="#d9d6cf"/></linearGradient>
        <linearGradient id="{{ uid }}-drop" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity=".3"/><stop offset="1" stop-color="#000" stop-opacity="0"/></linearGradient>
        <linearGradient id="{{ uid }}-sun" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#fff" stop-opacity=".1"/><stop offset=".6" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".12"/></linearGradient>
        {# Светотень ламели: наклон в одну сторону — светлый верх и тёмный низ; в обе стороны — светлая середина. #}
        <linearGradient id="{{ uid }}-sh1" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".45"/><stop offset=".5" stop-color="#fff" stop-opacity="0"/><stop offset="1" stop-color="#000" stop-opacity=".5"/></linearGradient>
        <linearGradient id="{{ uid }}-sh2" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#000" stop-opacity=".45"/><stop offset=".5" stop-color="#fff" stop-opacity=".4"/><stop offset="1" stop-color="#000" stop-opacity=".45"/></linearGradient>
        <linearGradient id="{{ uid }}-shv" x1="0" y1="0" x2="1" y2="0"><stop offset="0" stop-color="#000" stop-opacity=".35"/><stop offset=".3" stop-color="#fff" stop-opacity=".3"/><stop offset=".55" stop-color="#fff" stop-opacity=".1"/><stop offset=".75" stop-color="#000" stop-opacity=".1"/><stop offset="1" stop-color="#000" stop-opacity=".35"/></linearGradient>
        <pattern id="{{ uid }}-jaluzi" patternUnits="userSpaceOnUse" width="20" height="9.82"><rect width="20" height="9.82" style="fill: var(--ral)"/><rect width="20" height="9.82" fill="#000" fill-opacity=".55"/><rect width="20" height="8.05" style="fill: var(--ral)"/><rect class="zp-scene__shade" width="20" height="8.05" fill="url(#{{ uid }}-sh1)"/></pattern>
        <pattern id="{{ uid }}-jaluzi-double" patternUnits="userSpaceOnUse" width="20" height="9.82"><rect width="20" height="9.82" style="fill: var(--ral)"/><rect width="20" height="9.82" fill="#000" fill-opacity=".55"/><rect width="20" height="8.05" style="fill: var(--ral)"/><rect class="zp-scene__shade" width="20" height="8.05" fill="url(#{{ uid }}-sh2)"/></pattern>
        <pattern id="{{ uid }}-profnastil" patternUnits="userSpaceOnUse" width="11.9" height="20"><rect width="11.9" height="20" style="fill: var(--ral)"/><rect class="zp-scene__shade" width="11.9" height="20" fill="url(#{{ uid }}-shv)"/></pattern>
        <pattern id="{{ uid }}-profnastil-wide" patternUnits="userSpaceOnUse" width="23.8" height="20"><rect width="23.8" height="20" style="fill: var(--ral)"/><rect class="zp-scene__shade" width="23.8" height="20" fill="url(#{{ uid }}-shv)"/></pattern>
        <pattern id="{{ uid }}-shtaketnik" patternUnits="userSpaceOnUse" width="16.5" height="20"><rect width="12.4" height="20" style="fill: var(--ral)"/><rect class="zp-scene__shade" width="12.4" height="20" fill="url(#{{ uid }}-shv)"/></pattern>
        <pattern id="{{ uid }}-setka" patternUnits="userSpaceOnUse" width="5.2" height="20.7"><rect width="1.3" height="20.7" style="fill: var(--ral)"/><rect y="9.6" width="5.2" height="1.3" style="fill: var(--ral)"/></pattern>
        <pattern id="{{ uid }}-wood" patternUnits="userSpaceOnUse" width="200" height="19.6"><path d="M0 3.9C50 1 100 6.9 140 3.4S185 4.9 200 3.9M0 13.7C60 16.7 110 10.8 150 14.2S190 12.7 200 13.7" stroke="#c99a68" stroke-width="1.4" fill="none"/></pattern>
    </defs>

    <rect width="1200" height="470" fill="url(#{{ uid }}-sky)"/>
    <ellipse cx="300" cy="66" rx="110" ry="20" fill="#fff" opacity=".7"/>
    <ellipse cx="372" cy="52" rx="70" ry="18" fill="#fff" opacity=".7"/>
    <ellipse cx="960" cy="94" rx="90" ry="15" fill="#fff" opacity=".55"/>
    <path d="M0 197 q120 -62 240 -10 t264 0 t264 -21 t240 10 t192 0 V414 H0z" fill="#a9c196"/>
    <rect y="248.6" width="1200" height="165.4" fill="#8fb27a"/>

    {# Дом в глубине участка. #}
    <rect x="818" y="74" width="24" height="83" fill="#8b6d5c"/>
    <polygon points="458,179 708,35.7 958,179" fill="#4a5058"/>
    <polygon points="708,35.7 958,179 743,179" fill="#3c4249"/>
    <rect x="480" y="179" width="456" height="139" fill="#ece5d8"/>
    <rect x="480" y="179" width="456" height="11" fill="#d6cebf"/>
    <polygon points="647,179 708,83.5 769,179" fill="#e3dccd"/>
    {% for w in [[686, 111.7, 43.4, 52.1], [519, 218.1, 56.5, 60.8], [615, 218.1, 56.5, 60.8], [840.5, 218.1, 56.5, 60.8]] %}
        <rect x="{{ w[0] }}" y="{{ w[1] }}" width="{{ w[2] }}" height="{{ w[3] }}" fill="#8fabbf"/>
        <rect x="{{ w[0] }}" y="{{ w[1] }}" width="{{ w[2] }}" height="{{ w[3] }}" fill="url(#{{ uid }}-glass)"/>
        <rect x="{{ w[0] }}" y="{{ w[1] }}" width="{{ w[2] }}" height="{{ w[3] }}" fill="none" stroke="#f6f3ec" stroke-width="3.9"/>
        <line x1="{{ w[0] + w[2] / 2 }}" y1="{{ w[1] }}" x2="{{ w[0] + w[2] / 2 }}" y2="{{ w[1] + w[3] }}" stroke="#f6f3ec" stroke-width="3"/>
    {% endfor %}
    <rect x="753.6" y="222.5" width="43.4" height="95.5" fill="#6b4f3f"/>
    <rect x="480" y="302.8" width="456" height="15.2" fill="#b7aea0"/>

    {# Дерево и куст на участке. #}
    <rect x="192.8" y="176.2" width="14.5" height="188.2" fill="#76573f"/>
    <circle cx="200" cy="132.7" r="86.9" fill="#5c8c4b"/>
    <circle cx="134.8" cy="176.2" r="65.2" fill="#6a9a56"/>
    <circle cx="265.2" cy="168.9" r="68.8" fill="#527d43"/>
    <circle cx="1080" cy="300" r="70" fill="#5f8e4d"/>
    <circle cx="1140" cy="318" r="56" fill="#527d43"/>

    <rect y="408.8" width="1200" height="17.6" fill="#6e9a5b"/>

    {# Забор. #}
    <rect data-fence-body x="0" y="{{ top }}" width="1200" height="{{ ground - top }}" fill="url(#{{ uid }}-{{ pattern }})" data-fill-prefix="{{ uid }}"/>
    <rect class="zp-scene__wood" data-fence-body x="0" y="{{ top }}" width="1200" height="{{ ground - top }}" fill="url(#{{ uid }}-wood)"/>
    <rect data-fence-body x="0" y="{{ top }}" width="1200" height="{{ ground - top }}" fill="url(#{{ uid }}-sun)"/>
    <rect y="407.8" width="1200" height="6.2" style="fill: var(--ral)"/>
    <rect y="407.8" width="1200" height="6.2" fill="#000" fill-opacity=".12"/>
    {% for x in posts %}
        <rect data-fence-body x="{{ x - 4.65 }}" y="{{ top }}" width="9.3" height="{{ ground - top }}" style="fill: var(--ral)"/>
        <rect data-fence-body x="{{ x - 4.65 }}" y="{{ top }}" width="9.3" height="{{ ground - top }}" fill="#000" fill-opacity=".28"/>
    {% endfor %}
    <g data-fence-top transform="translate(0 {{ top }})">
        <rect width="1200" height="7.2" style="fill: var(--ral)"/>
        <rect width="1200" height="7.2" fill="#000" fill-opacity=".12"/>
        {% for x in posts %}
            <rect x="{{ x - 7 }}" y="-9.3" width="14" height="6.2" rx="2" style="fill: var(--ral)"/>
            <rect x="{{ x - 7 }}" y="-9.3" width="14" height="6.2" rx="2" fill="#000" fill-opacity=".2"/>
        {% endfor %}
    </g>

    {# Тротуар и тень забора. #}
    <rect y="426.4" width="1200" height="43.6" fill="url(#{{ uid }}-walk)"/>
    <rect y="426.4" width="1200" height="25.9" fill="url(#{{ uid }}-drop)"/>

    {# Человек 1,75 м на тротуаре. #}
    <g fill="#2f353c">
        <circle cx="672" cy="244.4" r="11.9"/>
        <path d="M651.9 262.2q20.1 -8.6 40.2 0l6.7 65.2q-2.9 5.8 -8.6 1.9l-4.8 -46v51.8h-28.8v-51.8l-4.8 46q-5.8 3.8 -8.6 -1.9z"/>
        <rect x="657.6" y="330.3" width="13" height="94" rx="4.8"/>
        <rect x="673.3" y="330.3" width="13" height="94" rx="4.8"/>
        <text x="672" y="223" text-anchor="middle" font-size="22.7" font-weight="600" font-family="Onest, sans-serif">1,75 м</text>
    </g>

    {# Линейка и подпись высоты. #}
    <g stroke="#23272d" stroke-opacity=".6" stroke-width="2">
        <line x1="51.7" y1="414" x2="51.7" y2="191.7"/>
        {% for m in [0.5, 1, 1.5, 2] %}
            <line x1="44.7" y1="{{ ground - m * scale }}" x2="58.7" y2="{{ ground - m * scale }}"/>
        {% endfor %}
    </g>
    <g font-size="20.7" fill="#23272d" fill-opacity=".7" text-anchor="end" font-family="'Sofia Sans Condensed', sans-serif">
        {% for m in [0.5, 1, 1.5, 2] %}
            <text x="40.7" y="{{ ground - m * scale + 6 }}">{{ m|number_format(m == m|round ? 0 : 1, ',', '') }}</text>
        {% endfor %}
    </g>
    <g data-fence-top transform="translate(0 {{ top }})">
        <line x1="51.7" x2="65.7" stroke="#2d7f27" stroke-width="3"/>
        <rect x="65.7" y="-20.7" width="98" height="41.4" rx="8" fill="#fff" stroke="#2d7f27" stroke-width="2"/>
        <text x="114.7" y="10" text-anchor="middle" font-size="27.9" font-weight="700" fill="#23272d" font-family="'Sofia Sans Condensed', sans-serif" data-cfg-height-tag>{{ height_label }}</text>
    </g>
</svg>
