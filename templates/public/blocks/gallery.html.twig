<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs" data-block-type="gallery">
    <h2 class="text-2xl font-semibold text-slate-950">{{ block.content.title|default(block.name) }}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
        {% for item in block.content.items|default([]) %}
            {% if item.image is defined %}
                <figure>
                    {{ responsive_image(item.image, {
                        alt: item.alt ?? null,
                        fallback_alt: item.caption ?? block.name,
                        class: 'aspect-4/3 w-full rounded-xl object-cover',
                        sizes: '(min-width: 1152px) 350px, (min-width: 768px) 33vw, 100vw',
                        eager: above_fold|default(false) and loop.index <= 3
                    }) }}
                    {% if item.caption is defined %}
                        <figcaption class="mt-2 text-sm text-slate-500">{{ item.caption }}</figcaption>
                    {% endif %}
                </figure>
            {% endif %}
        {% else %}
            <p class="text-sm text-slate-500">Галерея будет добавлена редактором.</p>
        {% endfor %}
    </div>
</section>
