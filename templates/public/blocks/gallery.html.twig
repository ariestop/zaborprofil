{# Фото из медиатеки: конструктор хранит src/alt, старые блоки — image/caption. Пустая галерея не выводится. #}
{% set images = (block.content.items ?? [])|filter(item => (item.src ?? item.image ?? '') is not empty) %}
{% if images|length > 0 %}
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs" data-block-type="gallery">
        {% if (block.content.title ?? '') is not empty %}
            <h2 class="mb-6 text-2xl font-semibold text-slate-950">{{ block.content.title }}</h2>
        {% endif %}
        <div class="grid gap-4 md:grid-cols-3">
            {% for item in images %}
                <figure>
                    {{ responsive_image(item.src ?? item.image, {
                        alt: item.alt ?? null,
                        fallback_alt: item.caption ?? block.name,
                        class: 'aspect-4/3 w-full rounded-xl object-cover',
                        sizes: '(min-width: 1152px) 350px, (min-width: 768px) 33vw, 100vw',
                        eager: above_fold|default(false) and loop.index <= 3
                    }) }}
                    {% if (item.caption ?? '') is not empty %}
                        <figcaption class="mt-2 text-sm text-slate-500">{{ item.caption }}</figcaption>
                    {% endif %}
                </figure>
            {% endfor %}
        </div>
    </section>
{% endif %}
