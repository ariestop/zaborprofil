{% set items = (block.content.items ?? [])|filter(item => (item.title ?? '') is not empty) %}
{% if items|length > 0 %}
    <section class="zp-section" data-block-type="steps" {% if (block.settings.anchor ?? '') is not empty %}id="{{ block.settings.anchor }}"{% endif %}>
        <div class="zp-container">
            <h2 class="zp-h2 mb-6 md:mb-8">{{ (block.content.title ?? '') is not empty ? block.content.title : (block.name ?? 'Как мы работаем') }}</h2>
            {% set cols = {1: 'md:grid-cols-1', 2: 'md:grid-cols-2', 3: 'md:grid-cols-3'}[items|length] ?? 'md:grid-cols-4' %}
            <ol class="grid gap-3 {{ cols }} md:gap-4">
                {% for item in items %}
                    {% set icon = item.icon ?? '' %}
                    <li class="zp-card flex gap-3.5 md:block">
                        {% if icon in ['measure', 'truck', 'fence', 'shield'] %}
                            {# Фирменная иконка вместо номера; номер остаётся в заголовке шага. #}
                            <svg class="size-11 shrink-0 text-ink" aria-hidden="true"><use href="#i-zp-{{ icon }}"/></svg>
                        {% else %}
                            <span class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-700 text-base font-bold text-white">{{ loop.index }}</span>
                        {% endif %}
                        <div>
                            <h3 class="text-base font-semibold text-ink md:mt-3">{% if icon in ['measure', 'truck', 'fence', 'shield'] %}<span class="text-brand-700">{{ loop.index }}.</span> {% endif %}{{ item.title }}</h3>
                            {% if (item.text ?? '') is not empty %}
                                <p class="mt-1 text-sm leading-6 text-graphite">{{ item.text }}</p>
                            {% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>
{% endif %}
