{% set items = block.content.items ?? [] %}
{% if items is iterable and items|length > 0 %}
    <section class="rounded-2xl bg-slate-950 p-6 text-white" data-block-type="steps">
        {% if (block.content.title ?? '') is not empty %}
            <h2 class="mb-6 text-2xl font-semibold">{{ block.content.title }}</h2>
        {% endif %}
        <div class="grid gap-4 md:grid-cols-4">
            {% for item in items %}
                <article class="rounded-xl bg-white/10 p-5">
                    <p class="text-sm font-semibold text-emerald-200">Шаг {{ loop.index }}</p>
                    <h3 class="mt-2 font-semibold">{{ item.title ?? '' }}</h3>
                    {% if (item.text ?? '') is not empty %}
                        <p class="mt-2 text-sm leading-6 text-slate-200">{{ item.text }}</p>
                    {% endif %}
                </article>
            {% endfor %}
        </div>
    </section>
{% endif %}
