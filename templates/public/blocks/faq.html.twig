{% set items = (block.content.items ?? [])|filter(item => (item.question ?? item.title ?? '') is not empty) %}
{% if items|length > 0 %}
    <section class="zp-section zp-section--alt" data-block-type="faq">
        <div class="zp-container max-w-3xl">
            <h2 class="zp-h2">{{ (block.content.title ?? '') is not empty ? block.content.title : 'Вопросы и ответы' }}</h2>
            <div class="mt-6 grid gap-2.5">
                {% for item in items %}
                    <details class="group rounded-2xl border border-line bg-white open:shadow-sm">
                        <summary class="flex min-h-14 cursor-pointer list-none items-center justify-between gap-4 px-5 py-3.5 font-semibold text-ink [&::-webkit-details-marker]:hidden">
                            {{ item.question ?? item.title }}
                            <svg class="size-5 shrink-0 text-graphite/70 transition group-open:rotate-180" aria-hidden="true"><use href="#i-chevron"/></svg>
                        </summary>
                        {% if (item.answer ?? '') is not empty %}
                            <p class="px-5 pb-5 text-base leading-7 text-graphite">{{ item.answer }}</p>
                        {% endif %}
                    </details>
                {% endfor %}
            </div>
        </div>
        {# Микроразметка FAQPage для поисковиков: те же вопросы и ответы, что видит посетитель. #}
        {% set faq_entities = [] %}
        {% for item in items %}
            {% set faq_entities = faq_entities|merge([{'@type': 'Question', 'name': item.question ?? item.title, 'acceptedAnswer': {'@type': 'Answer', 'text': item.answer ?? ''}}]) %}
        {% endfor %}
        <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@type': 'FAQPage', 'mainEntity': faq_entities}|json_encode(constant('JSON_UNESCAPED_UNICODE'))|raw }}</script>
    </section>
{% endif %}
