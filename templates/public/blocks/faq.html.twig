{% set items = (block.content.items ?? [])|filter(item => (item.question ?? item.title ?? '') is not empty) %}
{% if items|length > 0 %}
    <section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs" data-block-type="faq">
        <h2 class="text-2xl font-semibold text-slate-950">{{ (block.content.title ?? '') is not empty ? block.content.title : 'Вопросы и ответы' }}</h2>
        <div class="mt-6 space-y-3">
            {% for item in items %}
                <details class="rounded-xl border border-slate-200 p-4">
                    <summary class="cursor-pointer font-semibold text-slate-950">{{ item.question ?? item.title }}</summary>
                    {% if (item.answer ?? '') is not empty %}
                        <p class="mt-3 text-sm leading-6 text-slate-600">{{ item.answer }}</p>
                    {% endif %}
                </details>
            {% endfor %}
        </div>
    </section>
{% endif %}
