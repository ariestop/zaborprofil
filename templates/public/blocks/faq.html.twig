<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-block-type="faq">
    <h2 class="text-2xl font-semibold text-slate-950">{{ block.content.title|default(block.name) }}</h2>
    <div class="mt-6 space-y-3">
        {% for item in block.content.items|default([]) %}
            <details class="rounded-xl border border-slate-200 p-4">
                <summary class="cursor-pointer font-semibold text-slate-950">{{ item.question|default(item.title|default('Вопрос')) }}</summary>
                {% if item.answer is defined %}
                    <p class="mt-3 text-sm leading-6 text-slate-600">{{ item.answer }}</p>
                {% endif %}
            </details>
        {% else %}
            <p class="text-sm text-slate-500">FAQ будет добавлен редактором.</p>
        {% endfor %}
    </div>
</section>
