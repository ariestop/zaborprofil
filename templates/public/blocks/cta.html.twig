{# Призыв к действию: короткий текст, кнопка и телефон. #}
{% set cta_label = block.content.cta.label ?? '' %}
{% set cta_href = block.content.cta.href ?? '#lead-form' %}
{% if cta_href in ['#lead', '', '#'] %}{% set cta_href = '#lead-form' %}{% endif %}
<section class="zp-section" data-block-type="cta">
    <div class="zp-container">
        <div class="flex flex-col gap-6 rounded-3xl bg-brand-900 p-6 text-white sm:p-10 md:flex-row md:items-center md:justify-between">
            <div class="max-w-xl">
                <h2 class="text-2xl leading-tight font-bold text-balance md:text-3xl">{{ block.content.title ?? '' }}</h2>
                {% if (block.content.subtitle ?? '') is not empty %}
                    <p class="mt-3 text-lg leading-7 text-white/90">{{ block.content.subtitle }}</p>
                {% endif %}
                {% if (block.content.text ?? '') is not empty %}
                    <p class="mt-3 text-base leading-7 text-white/80">{{ block.content.text }}</p>
                {% endif %}
            </div>
            <div class="flex flex-col gap-3 sm:flex-row md:flex-col lg:flex-row">
                {% if cta_label is not empty %}
                    <a class="zp-btn zp-btn--light" href="{{ cta_href }}" data-lead-cta>{{ cta_label }}</a>
                {% endif %}
                <a class="zp-btn zp-btn--outline-light" href="{{ site.phone_href }}"><svg class="size-5" aria-hidden="true"><use href="#i-phone"/></svg>{{ site.phone }}</a>
            </div>
        </div>
    </div>
</section>
