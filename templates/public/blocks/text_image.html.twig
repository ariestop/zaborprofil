<section class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-xs md:grid-cols-2 md:items-center" data-block-type="text_image">
    <div class="prose max-w-none">
        <h2>{{ block.content.title|default(block.name) }}</h2>
        {% if block.content.text is defined %}
            <div>{{ block.content.text|raw }}</div>
        {% endif %}
    </div>
    {% if block.content.image is defined %}
        {{ responsive_image(block.content.image, {
            alt: block.content.alt ?? null,
            fallback_alt: block.content.title ?? block.name,
            class: 'w-full rounded-2xl object-cover',
            sizes: '(min-width: 1152px) 540px, (min-width: 768px) 50vw, 100vw',
            priority: above_fold|default(false)
        }) }}
    {% endif %}
</section>
