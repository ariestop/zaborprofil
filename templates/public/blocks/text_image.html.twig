<section class="grid gap-8 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm md:grid-cols-2 md:items-center" data-block-type="text_image">
    <div class="prose max-w-none">
        <h2>{{ block.content.title|default(block.name) }}</h2>
        {% if block.content.text is defined %}
            <div>{{ block.content.text|nl2br }}</div>
        {% endif %}
    </div>
    {% if block.content.image is defined %}
        <img class="w-full rounded-2xl object-cover" src="{{ block.content.image }}" alt="{{ block.content.alt|default(block.content.title|default(block.name)) }}" loading="lazy" decoding="async">
    {% endif %}
</section>
