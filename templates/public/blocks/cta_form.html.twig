<section class="zp-section" data-block-type="cta_form">
    <div class="zp-container grid gap-6 md:grid-cols-[1fr_26rem] md:items-start">
        <div>
            <h2 class="zp-h2">{{ block.content.title ?? block.name }}</h2>
            {% if (block.content.text ?? '') is not empty %}
                <p class="zp-lead">{{ block.content.text }}</p>
            {% endif %}
        </div>
        {% include 'public/partials/lead_form.html.twig' %}
    </div>
</section>
