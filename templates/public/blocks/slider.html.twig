{% set items = block.content.items ?? [] %}
{% if items is iterable and items|length > 0 %}
    {% set sliderSettings = {
        autoplay: block.settings.autoplay ?? true,
        loop: block.settings.loop ?? true,
        pagination: block.settings.pagination ?? true,
        navigation: block.settings.navigation ?? true,
        delayMs: block.settings.delayMs ?? 4500
    } %}

    <section class="not-prose space-y-6">
        <div
            class="swiper js-site-slider relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm"
            data-slider-settings='{{ sliderSettings|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}'
        >
            <div class="swiper-wrapper">
                {% for item in items %}
                    <article class="swiper-slide">
                        <div class="grid gap-6 p-6 md:grid-cols-2 md:items-center">
                            <div class="space-y-4">
                                {% if item.title is defined and item.title %}
                                    <h2 class="text-2xl font-semibold text-slate-950 md:text-3xl">{{ item.title }}</h2>
                                {% endif %}
                                {% if item.text is defined and item.text %}
                                    <p class="text-base leading-7 text-slate-700">{{ item.text }}</p>
                                {% endif %}
                                {% if item.buttonLabel is defined and item.buttonLabel %}
                                    <a
                                        href="{{ item.buttonHref is defined and item.buttonHref ? item.buttonHref : '#' }}"
                                        class="inline-flex items-center rounded-md bg-emerald-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-emerald-700"
                                    >
                                        {{ item.buttonLabel }}
                                    </a>
                                {% endif %}
                            </div>
                            {% if item.src is defined and item.src %}
                                <figure class="overflow-hidden rounded-xl bg-slate-100">
                                    <img
                                        src="{{ item.src }}"
                                        alt="{{ item.alt is defined ? item.alt : '' }}"
                                        class="h-full w-full object-cover"
                                        loading="lazy"
                                    >
                                </figure>
                            {% endif %}
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="pointer-events-none absolute inset-x-0 top-1/2 z-10 hidden -translate-y-1/2 justify-between px-3 md:flex">
                <button
                    type="button"
                    class="js-site-slider-prev pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-800 shadow transition hover:bg-white"
                    aria-label="Предыдущий слайд"
                >
                    <span aria-hidden="true">←</span>
                </button>
                <button
                    type="button"
                    class="js-site-slider-next pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-800 shadow transition hover:bg-white"
                    aria-label="Следующий слайд"
                >
                    <span aria-hidden="true">→</span>
                </button>
            </div>

            <div class="js-site-slider-pagination px-6 pb-4"></div>
        </div>
    </section>
{% endif %}
