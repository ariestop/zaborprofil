{% set items = block.content.items ?? [] %}
{% if items is iterable and items|length > 0 %}
    {% set sliderSettings = {
        autoplay: block.settings.autoplay ?? true,
        loop: block.settings.loop ?? true,
        pagination: block.settings.pagination ?? true,
        navigation: block.settings.navigation ?? true,
        delayMs: block.settings.delayMs ?? 4500,
        effect: block.settings.effect ?? 'slide',
        pauseOnHover: block.settings.pauseOnHover ?? true,
        disableOnInteraction: block.settings.disableOnInteraction ?? false,
        speedMs: block.settings.speedMs ?? 500,
        breakpoints: {
            mobileSlidesPerView: block.settings.breakpoints.mobileSlidesPerView ?? 1,
            tabletSlidesPerView: block.settings.breakpoints.tabletSlidesPerView ?? 1,
            desktopSlidesPerView: block.settings.breakpoints.desktopSlidesPerView ?? 1,
            mobileSpaceBetween: block.settings.breakpoints.mobileSpaceBetween ?? 8,
            tabletSpaceBetween: block.settings.breakpoints.tabletSpaceBetween ?? 16,
            desktopSpaceBetween: block.settings.breakpoints.desktopSpaceBetween ?? 24
        },
        a11yLabels: {
            prevSlide: block.settings.a11yLabels.prevSlide ?? 'Предыдущий слайд',
            nextSlide: block.settings.a11yLabels.nextSlide ?? 'Следующий слайд',
            paginationBullet: block.settings.a11yLabels.paginationBullet ?? 'Перейти к слайду {{index}}'
        }
    } %}
    {% set customClass = block.settings.className ?? '' %}

    <section class="not-prose relative left-1/2 w-screen -translate-x-1/2 {{ customClass }}">
        <div
            class="swiper js-site-slider relative w-full overflow-hidden bg-slate-950"
            data-slider-settings='{{ sliderSettings|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}'
        >
            <div class="swiper-wrapper">
                {% for item in items %}
                    <article class="swiper-slide">
                        <div class="relative isolate min-h-[340px] sm:min-h-[420px] lg:min-h-[520px]">
                            {% if item.src is defined and item.src %}
                                <img
                                    src="{{ item.src }}"
                                    alt="{{ item.alt is defined ? item.alt : '' }}"
                                    class="absolute inset-0 h-full w-full object-cover"
                                    loading="lazy"
                                >
                            {% else %}
                                <div class="absolute inset-0 bg-gradient-to-br from-slate-900 to-slate-700"></div>
                            {% endif %}

                            <div class="absolute inset-0 bg-black/30"></div>

                            <div class="relative z-10 mx-auto flex h-full w-full max-w-6xl items-end px-6 py-10 sm:py-14 lg:py-20">
                                <div class="space-y-4">
                                {% if item.title is defined and item.title %}
                                    <h2 class="inline-block bg-red-700/90 px-3 py-2 text-3xl font-semibold leading-tight text-white sm:px-4 sm:py-3 sm:text-4xl lg:text-6xl">
                                        {{ item.title }}
                                    </h2>
                                {% endif %}
                                {% if item.text is defined and item.text %}
                                    <p class="inline-block bg-black/80 px-3 py-2 text-lg leading-tight text-white sm:px-4 sm:py-3 sm:text-2xl">
                                        {{ item.text }}
                                    </p>
                                {% endif %}
                                {% if item.buttonLabel is defined and item.buttonLabel %}
                                    <a
                                        href="{{ item.buttonHref is defined and item.buttonHref ? item.buttonHref : '#' }}"
                                        class="inline-flex items-center rounded-md bg-white/95 px-4 py-2 text-sm font-semibold text-slate-900 transition hover:bg-white"
                                    >
                                        {{ item.buttonLabel }}
                                    </a>
                                {% endif %}
                            </div>
                            </div>
                        </div>
                    </article>
                {% endfor %}
            </div>

            <div class="pointer-events-none absolute inset-x-0 top-1/2 z-20 hidden -translate-y-1/2 justify-between px-3 md:flex lg:px-6">
                <button
                    type="button"
                    class="js-site-slider-prev pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-800 shadow transition hover:bg-white"
                    aria-label="{{ sliderSettings.a11yLabels.prevSlide }}"
                >
                    <span aria-hidden="true">←</span>
                </button>
                <button
                    type="button"
                    class="js-site-slider-next pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-white/90 text-slate-800 shadow transition hover:bg-white"
                    aria-label="{{ sliderSettings.a11yLabels.nextSlide }}"
                >
                    <span aria-hidden="true">→</span>
                </button>
            </div>

            <div class="js-site-slider-pagination absolute bottom-3 left-1/2 z-20 -translate-x-1/2"></div>
        </div>
    </section>
{% endif %}
