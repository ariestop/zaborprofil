<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-block-type="map">
    <h2 class="text-2xl font-semibold text-slate-950">{{ block.content.title|default(block.name) }}</h2>
    {% if block.content.embedUrl is defined and block.content.embedUrl %}
        <iframe class="mt-6 h-[420px] w-full rounded-2xl border-0" src="{{ block.content.embedUrl }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ block.content.address|default(block.name) }}"></iframe>
    {% elseif block.content.address is defined %}
        <p class="mt-4 text-slate-700">{{ block.content.address }}</p>
    {% endif %}
</section>
