<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-block-type="table">
    <h2 class="text-2xl font-semibold text-slate-950">{{ block.content.title|default(block.name) }}</h2>
    <div class="mt-6 overflow-x-auto">
        <table class="min-w-full divide-y divide-slate-200 text-sm">
            <thead>
                <tr>
                    {% for column in block.content.columns|default([]) %}
                        <th class="px-4 py-3 text-left font-semibold text-slate-700">{{ column.label|default(column) }}</th>
                    {% endfor %}
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                {% for row in block.content.rows|default([]) %}
                    <tr>
                        {% for column in block.content.columns|default([]) %}
                            {% set key = column.key|default(column) %}
                            <td class="px-4 py-3 text-slate-700">{{ row[key]|default('') }}</td>
                        {% endfor %}
                    </tr>
                {% else %}
                    <tr><td class="px-4 py-3 text-slate-500">Таблица будет добавлена редактором.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</section>
