<section class="zp-section" data-block-type="image">
    <div class="zp-container">
        {% if (block.content.src ?? block.content.image ?? '') is not empty %}
            <figure>
                {{ responsive_image(block.content.src ?? block.content.image, {
                    alt: block.content.alt ?? null,
                    fallback_alt: block.name,
                    class: 'w-full rounded-2xl object-cover',
                    sizes: '(min-width: 1152px) 1152px, 100vw',
                    priority: above_fold|default(false)
                }) }}
                {% if (block.content.caption ?? '') is not empty %}
                    <figcaption class="mt-3 text-sm text-slate-500">{{ block.content.caption }}</figcaption>
                {% endif %}
            </figure>
        {% endif %}
    </div>
</section>
