<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-block-type="image">
    {% if block.content.image is defined %}
        <figure>
            <img class="w-full rounded-2xl object-cover" src="{{ block.content.image }}" alt="{{ block.content.alt|default(block.name) }}" loading="lazy" decoding="async">
            {% if block.content.caption is defined %}
                <figcaption class="mt-3 text-sm text-slate-500">{{ block.content.caption }}</figcaption>
            {% endif %}
        </figure>
    {% else %}
        <p class="text-sm text-slate-500">Изображение будет добавлено редактором.</p>
    {% endif %}
</section>
