<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-xs" data-block-type="image">
    {% if block.content.image is defined %}
        <figure>
            {{ responsive_image(block.content.image, {
                alt: block.content.alt ?? null,
                fallback_alt: block.name,
                class: 'w-full rounded-2xl object-cover',
                sizes: '(min-width: 1152px) 1100px, 100vw',
                priority: above_fold|default(false)
            }) }}
            {% if block.content.caption is defined %}
                <figcaption class="mt-3 text-sm text-slate-500">{{ block.content.caption }}</figcaption>
            {% endif %}
        </figure>
    {% else %}
        <p class="text-sm text-slate-500">Изображение будет добавлено редактором.</p>
    {% endif %}
</section>
