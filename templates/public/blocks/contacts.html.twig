<section class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-block-type="contacts">
    <h2 class="text-2xl font-semibold text-slate-950">{{ block.content.title|default(block.name) }}</h2>
    <div class="mt-6 grid gap-4 md:grid-cols-3">
        {% for item in block.content.items|default([]) %}
            <article class="rounded-xl bg-slate-50 p-5">
                <p class="text-sm font-semibold text-slate-500">{{ item.label|default('Контакт') }}</p>
                <p class="mt-2 font-semibold text-slate-950">{{ item.value|default('') }}</p>
            </article>
        {% else %}
            <p class="text-sm text-slate-500">Контакты будут добавлены редактором.</p>
        {% endfor %}
    </div>
</section>
