{% if breadcrumbs is defined and breadcrumbs|length > 1 %}
    <nav class="mb-8 text-sm text-graphite" aria-label="Хлебные крошки">
        <ol class="flex flex-wrap gap-2">
            {% for breadcrumb in breadcrumbs %}
                <li>
                    {% if breadcrumb.current %}
                        <span class="text-ink" aria-current="page">{{ breadcrumb.label }}</span>
                    {% else %}
                        <a class="hover:text-emerald-700" href="{{ breadcrumb.path }}">{{ breadcrumb.label }}</a>
                        <span class="ml-2 text-line-strong">/</span>
                    {% endif %}
                </li>
            {% endfor %}
        </ol>
    </nav>
{% endif %}
