{% extends 'base.html.twig' %}

{% block title %}Каталог{% endblock %}

{% block body %}
    <main class="mx-auto max-w-6xl px-6 py-12">
        {% include 'public/catalog/_breadcrumbs.html.twig' %}

        <p class="text-sm font-semibold uppercase tracking-wide text-emerald-700">Каталог</p>
        <h1 class="mt-2 text-4xl font-bold tracking-tight text-slate-950">Каталог продукции</h1>
        <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700">
            Подберите забор, комплектующие и варианты исполнения для вашего участка.
        </p>

        {% if categories %}
            <section class="mt-10">
                <h2 class="text-2xl font-bold text-slate-950">Категории</h2>
                <div class="mt-5 grid gap-4 md:grid-cols-2">
                    {% for category in categories %}
                        <a class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-emerald-300 hover:shadow-md" href="{{ category.path }}">
                            <h3 class="text-lg font-semibold text-slate-950">{{ category.title }}</h3>
                            {% if category.description %}
                                <p class="mt-2 text-sm leading-6 text-slate-600">{{ category.description }}</p>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}

        {% if products %}
            <section class="mt-12">
                <h2 class="text-2xl font-bold text-slate-950">Товары</h2>
                <div class="mt-5 grid gap-4 md:grid-cols-3">
                    {% for product in products %}
                        <a class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:border-emerald-300 hover:shadow-md" href="{{ product.path }}">
                            <h3 class="text-lg font-semibold text-slate-950">{{ product.name }}</h3>
                            {% if product.summary %}
                                <p class="mt-2 text-sm leading-6 text-slate-600">{{ product.summary }}</p>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            </section>
        {% endif %}
    </main>
{% endblock %}
