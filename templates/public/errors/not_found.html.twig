{% extends 'base.html.twig' %}

{% block title %}Страница не найдена{% endblock %}

{% block meta_description %}{% endblock %}

{% block meta_robots %}
    <meta name="robots" content="noindex, nofollow">
{% endblock %}

{% block body %}
    <main class="mx-auto max-w-6xl px-6 py-16">
        <section class="overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-sm">
            <div class="grid gap-8 p-8 md:grid-cols-[1fr_320px] md:p-12">
                <div class="flex flex-col justify-center">
                    <p class="text-sm font-semibold uppercase tracking-[0.3em] text-emerald-700">404</p>
                    <h1 class="mt-4 max-w-2xl text-4xl font-bold tracking-tight text-slate-950 md:text-5xl">Страница не найдена</h1>
                    <p class="mt-5 max-w-2xl text-base leading-7 text-slate-600">
                        Возможно, адрес изменился, страница еще не опубликована или ссылка была набрана с ошибкой.
                        Перейдите на главную или откройте каталог, чтобы продолжить.
                    </p>

                    <div class="mt-8 flex flex-wrap gap-3">
                        <a class="rounded-lg bg-emerald-700 px-5 py-3 text-sm font-semibold text-white hover:bg-emerald-800" href="/">На главную</a>
                        <a class="rounded-lg border border-slate-300 px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50" href="/catalog/">Открыть каталог</a>
                    </div>
                </div>

                <div class="rounded-2xl bg-slate-50 p-6">
                    <div class="rounded-2xl border border-dashed border-slate-300 bg-white p-6">
                        <p class="text-sm font-semibold text-slate-900">Нужна помощь?</p>
                        <p class="mt-3 text-sm leading-6 text-slate-600">
                            Оставьте заявку, и мы подскажем нужный раздел или поможем подобрать решение для забора.
                        </p>
                    </div>
                </div>
            </div>
        </section>
    </main>
{% endblock %}
