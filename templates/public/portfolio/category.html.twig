{% extends 'base.html.twig' %}

{% block title %}{{ category.title }} — портфолио | {{ site.name }}{% endblock %}

{% block body %}
    <main>
        <section class="zp-pf-band">
            {% include 'public/portfolio/_stripes.html.twig' %}
            <div class="zp-container">
                {% include 'public/portfolio/_breadcrumbs.html.twig' %}
                <h1 class="zp-pf-h1">{{ category.title }}</h1>
                <p class="zp-pf-lead">
                    {{ category.description ?? (projects|length ~ ' ' ~ projects|length|plural_ru('работа', 'работы', 'работ') ~ ' в Саратове и области') }}
                </p>
                <nav class="zp-pf-switch" aria-label="Разделы портфолио">
                    <a class="zp-pf-switch__item" href="/portfolio/">Все работы <b>{{ total }}</b></a>
                    {% for card in categories %}
                        <a class="zp-pf-switch__item" href="{{ card.category.path }}"{% if card.category.id.equals(category.id) %} aria-current="page"{% endif %}>
                            {{ card.category.shortTitle }} <b>{{ card.count }}</b>
                        </a>
                    {% endfor %}
                </nav>
            </div>
        </section>

        <section class="zp-section">
            <div class="zp-container">
                <h2 class="sr-only">Работы раздела «{{ category.title }}»</h2>
                {# На телефоне — переключатель вида: карточки с подписями или плотная сетка фото 3 в ряд (assets/site/portfolio.ts). #}
                <div class="zp-pf-view" role="group" aria-label="Вид списка работ" data-pf-view hidden>
                    <button type="button" data-pf-view-mode="cards" aria-pressed="true">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M4 4h16v7H4zM4 15h16v5H4z"/></svg>Карточки
                    </button>
                    <button type="button" data-pf-view-mode="grid" aria-pressed="false">
                        <svg aria-hidden="true" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2" d="M3 3h18v18H3zM9 3v18M15 3v18M3 9h18M3 15h18"/></svg>Сетка
                    </button>
                </div>
                <div class="zp-pf-grid" data-pf-grid>
                    {% for project in projects %}
                        {% include 'public/portfolio/_card.html.twig' with {project: project, eager: loop.index <= 3, post: true} only %}
                    {% endfor %}
                </div>
                {% include 'public/portfolio/_cta.html.twig' %}
            </div>
        </section>
        {% include 'public/portfolio/_lead.html.twig' %}
    </main>
{% endblock %}
