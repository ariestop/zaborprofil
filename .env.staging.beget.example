# Шаблон ~/dev.zaborprofil.ru/.env.local для staging на Beget (https://dev.zaborprofil.ru).
# Копируется на сервер вручную (chmod 600), в Git не попадает. Реальные значения в репозиторий не писать.
# Подробности: docs/49-beget-staging-deploy.md

APP_ENV=staging
APP_DEBUG=0
# openssl rand -hex 32
APP_SECRET=<случайная строка>
APP_SHARE_DIR=var/share

# Отдельная БД MySQL 8.4 staging, не боевая (на Beget хост обычно localhost, имя БД = имя пользователя).
# Спецсимволы пароля кодируются в URL (rawurlencode). Redis не используется: кэш приложения файловый.
DATABASE_URL="mysql://<db_user>:<db_password>@localhost:3306/<db_name>?serverVersion=8.4&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
# Со staging не должны уходить реальные письма.
MAILER_DSN=null://null

LEAD_NOTIFICATION_EMAIL=
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=

SITE_URL="https://dev.zaborprofil.ru"
DEFAULT_URI="https://dev.zaborprofil.ru"

# Basic Auth проверяет приложение (StagingAccessSubscriber). Без STAGING_AUTH_ENABLED=1 деплой откажется работать.
STAGING_AUTH_ENABLED=1
STAGING_AUTH_USER=dev
# Хеш ТОЛЬКО в одинарных кавычках: Symfony Dotenv раскрывает $... в значениях без кавычек и портит bcrypt.
# Генерация (пароль не печатать в общие логи):
#   /usr/local/bin/php8.5 -r 'echo "STAGING_AUTH_HASH=\x27".password_hash($argv[1], PASSWORD_BCRYPT)."\x27\n";' 'ПАРОЛЬ'
STAGING_AUTH_HASH='<bcrypt-хеш>'
