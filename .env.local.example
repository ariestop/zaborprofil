APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-this-local-secret
APP_SHARE_DIR=var/share

DATABASE_URL="mysql://zaborprofil:zaborprofil@mysql:3306/zaborprofil?serverVersion=8.4&charset=utf8mb4"
REDIS_URL="redis://redis:6379"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://mailpit:1025

SITE_URL="http://localhost"
DEFAULT_URI="http://localhost"

MYSQL_DATABASE=zaborprofil
MYSQL_USER=zaborprofil
MYSQL_PASSWORD=zaborprofil
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=13306
REDIS_PORT=16379
HTTP_PORT=80
# Только loopback на хосте (без доступа из LAN): HTTP_PORT=127.0.0.1:8081 — тогда с другого компьютера нужен SSH port forwarding; см. docs/33-local-development.md
MAILPIT_PORT=8025
ADMINER_PORT=8080
VITE_PORT=5173
# Dev-режим фронтенда: страницы грузят скрипты и стили прямо с Vite (HMR), `npm run build` не нужен.
# Раскомментируйте и запустите `make npm-dev` в отдельном терминале; пока dev-сервер не запущен,
# страницы остаются без стилей и JS. Адрес открывается в браузере на хосте, порт — как у VITE_PORT.
# VITE_DEV_SERVER_URL=http://localhost:5173

# Владелец named volume node_modules в контейнере node (см. docker-compose.override.yml).
# Если `make npm-install` падает с EACCES на mkdir в node_modules, выставьте UID/GID
# своего пользователя Linux: `id -u` и `id -g` (часто 1000:1000).
# DOCKER_UID=1000
# DOCKER_GID=1000

# off | develop,debug
XDEBUG_MODE=off
