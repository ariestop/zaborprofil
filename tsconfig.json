{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "paths": {
      "*": ["./*"],
      "@admin/*": ["./admin/*"],
      "@admin-ui/*": ["./admin/shared/ui/*"],
      "@/components/*": ["./admin/components/tiptap-templates/*"],
      "@/hooks/*": ["./admin/components/hooks/*"],
      "@/lib/*": ["./admin/components/lib/*"]
    }
  },
  "include": ["assets/**/*.ts", "assets/**/*.tsx", "admin/**/*.ts", "admin/**/*.tsx", "src/**/*.d.ts", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
