{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@admin/*": ["assets/admin/*"],
      "@admin-ui/*": ["assets/admin/shared/ui/*"],
      "@/components/*": ["assets/admin/components/tiptap-templates/*"],
      "@/hooks/*": ["assets/admin/components/hooks/*"],
      "@/lib/*": ["assets/admin/components/lib/*"]
    }
  },
  "include": ["assets/**/*.ts", "assets/**/*.tsx", "src/**/*.d.ts", "vite.config.ts", "vitest.config.ts", "tailwind.config.ts"]
}
