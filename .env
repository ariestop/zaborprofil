APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-in-env-local
APP_SHARE_DIR=var/share

DATABASE_URL="mysql://zaborprofil:zaborprofil@mysql:3306/zaborprofil?serverVersion=8.4&charset=utf8mb4"
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=smtp://mailpit:1025
LEAD_NOTIFICATION_EMAIL=
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=

# Error tracking (Sentry или совместимый self-hosted, например GlitchTip). Пусто — выключено.
SENTRY_DSN=
SENTRY_RELEASE=

SITE_URL="http://localhost"
DEFAULT_URI="http://localhost"

MYSQL_DATABASE=zaborprofil
MYSQL_USER=zaborprofil
MYSQL_PASSWORD=zaborprofil
MYSQL_ROOT_PASSWORD=root
MYSQL_PORT=13306
HTTP_PORT=80
MAILPIT_PORT=8025
ADMINER_PORT=8080
VITE_PORT=5173
XDEBUG_MODE=off

# Запуск Doctrine-миграций из веб-админки (только SUPER_ADMIN + confirm-token). 0 — выключено, миграции выполняет CLI.
ADMIN_WEB_MIGRATIONS_ENABLED=0
